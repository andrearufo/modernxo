// main.js - Prototipo del progetto Vue

import Vue from 'vue';

Vue.config.productionTip = false;

new Vue({
  el: '#app',
  data() {
    return {
      grid: [
        [null, null, null],
        [null, null, null],
        [null, null, null]
      ],
      currentPlayer: 'X',
      moves: [],
      message: "Tocca al giocatore X",
    };
  },
  methods: {
    makeMove(row, col) {
      // Controlla se la cella è già occupata
      if (this.grid[row][col] !== null) {
        return;
      }

      // Effettua la mossa
      this.$set(this.grid[row], col, this.currentPlayer);
      this.moves.push({ row, col });

      // Controlla se è necessario rimuovere la quinta mossa precedente
      if (this.moves.length > 5) {
        const oldMove = this.moves.shift();
        this.$set(this.grid[oldMove.row], oldMove.col, null);
      }

      // Controlla se c'è un vincitore
      if (this.checkWinner()) {
        this.message = `Il giocatore ${this.currentPlayer} ha vinto!`;
        return;
      }

      // Cambia giocatore
      this.currentPlayer = this.currentPlayer === 'X' ? 'O' : 'X';
      this.message = `Tocca al giocatore ${this.currentPlayer}`;
    },
    checkWinner() {
      // Controlla righe, colonne e diagonali
      const lines = [
        // Righe
        ...this.grid,
        // Colonne
        [this.grid[0][0], this.grid[1][0], this.grid[2][0]],
        [this.grid[0][1], this.grid[1][1], this.grid[2][1]],
        [this.grid[0][2], this.grid[1][2], this.grid[2][2]],
        // Diagonali
        [this.grid[0][0], this.grid[1][1], this.grid[2][2]],
        [this.grid[0][2], this.grid[1][1], this.grid[2][0]]
      ];

      return lines.some(line => line.every(cell => cell === this.currentPlayer));
    }
  },
  template: `
    <div id="app">
      <div class="game">
        <div v-for="(row, rowIndex) in grid" :key="rowIndex" class="row">
          <div v-for="(cell, cellIndex) in row" :key="cellIndex" class="cell" @click="makeMove(rowIndex, cellIndex)">
            {{ cell }}
          </div>
        </div>
        <p>{{ message }}</p>
      </div>
    </div>
  `,
  style: `
    .game {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .row {
      display: flex;
    }
    .cell {
      width: 50px;
      height: 50px;
      border: 1px solid black;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      cursor: pointer;
    }
  `
});
